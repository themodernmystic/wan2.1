  assigned_builder_id String?
  assigned_reviewer_id String?
  confidence_score Float?
  description    String?
  execution_mode String?
  founder_id     String?
  is_acceptance_test Boolean?
  is_legacy_demo Boolean?
  lifecycle_stage String?
  name           String?
  parent_venture_id String?
  status         String?
  tags           String?
  truth_disclosure String?
  venture_type   String?

  @@map("Venture")
}

