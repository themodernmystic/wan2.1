// --- Infra models (auth plumbing that used to be inside managed Base44 auth) ---

model AuthOtp {
  id         String   @id @default(cuid())
  email      String
  code       String
  purpose    String   // "register" | "login"
  expires_at DateTime
  consumed   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("auth_otp")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime
  consumed   Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("password_reset_token")
}
