# Copy to .env and fill in. Nothing here is required to boot the server except
# DATABASE_URL and JWT_SECRET — every integration is optional and fails with a
# clear error only when a feature that needs it is actually used.

# --- Core (required) ---
DATABASE_URL="postgresql://user:password@host:5432/hermetica_synthetix?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=8080
WEB_ORIGIN="*"

# --- LLM (Riley's reasoning, content generation, validation scoring, etc.) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Image generation ---
OPENAI_API_KEY=
IMAGE_GEN_API_KEY=

# --- Email (registration OTP, password reset, agent-sent emails) ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@yourdomain.com"

# --- File storage ---
STORAGE_DRIVER="local"          # "local" | "s3"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_PUBLIC_BASE_URL="/uploads"
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Stripe (rileyStripeConnect, pricing/revenue functions) ---
STRIPE_SECRET_KEY=

# --- Google OAuth login + Google Drive connector (report archiving) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
